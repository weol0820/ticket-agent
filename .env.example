# 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略，切勿提交）

# DeepSeek API 密钥（必填）——在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-your-key-here

# API 端点（可选）。留空 = 官方公开端点 https://api.deepseek.com
# 使用 OpenAI 兼容代理时取消注释并填写，例如 http://127.0.0.1:8000/v1
# DEEPSEEK_BASE_URL=

# 模型 id：由你的 API 端点决定（deepseek-chat / deepseek-reasoner / deepseek-v4-flash ...）
DSH_MODEL=deepseek-chat

# 单次任务输出 token 上限
DSH_MAX_TOKENS=8192

# 知识库检索返回条数
KB_TOP_K=3

# 优先级 >= 该值的工单建议升级人工处理
ESCALATE_SCORE=8
